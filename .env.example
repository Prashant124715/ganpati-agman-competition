# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Server ---
PORT=3000
NODE_ENV=production

# Base URL of the deployed site (used in emails). No trailing slash.
BASE_URL=http://localhost:3000

# --- Security ---
# Long random string used to sign login/session cookies and OTP hashes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# --- First admin account (used only by `npm run create-admin`) ---
ADMIN_NAME=Marathi Club Admin
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change_this_password

# --- Outgoing email (for voter OTP verification) ---
# Works with any standard SMTP provider (college email, Gmail with an App Password,
# Zoho, Brevo/Sendinblue, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sending_address@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Marathi Club Ganpati Agman" <your_sending_address@gmail.com>

# If SMTP_* is left blank, the app runs in "dev mail mode": instead of sending a
# real email it prints the OTP to the server console AND saves it to the
# admin dashboard's "Dev Mail Outbox" tab, so you can test voting end-to-end
# before real email is configured. Do NOT leave SMTP unset in production.
