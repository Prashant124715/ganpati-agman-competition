<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<% if (pastDeadline) { %>
  <div class="deadline-banner">The submission deadline for <%= site.competitionName %> has passed. Entries can no longer be accepted.</div>
<% } %>

<section class="section">
  <div class="container">
    <h1 class="section-title"><%= category.label %></h1>
    <p class="section-subtitle"><%= category.description %> <%= category.instructions %></p>

    <div class="form-card">
      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <ul>
            <% errors.forEach(e => { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/submit/<%= category.key %>" enctype="multipart/form-data" novalidate>
        <div class="field">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" value="<%= values.name || '' %>" required <%= pastDeadline ? 'disabled' : '' %> />
        </div>

        <div class="field">
          <label for="collegeId"><%= category.audience === 'faculty-only' ? 'Employee / Faculty ID' : 'College ID' %></label>
          <input type="text" id="collegeId" name="collegeId" value="<%= values.collegeId || '' %>" required <%= pastDeadline ? 'disabled' : '' %> />
        </div>

        <div class="field">
          <label for="email"><%= category.audience === 'faculty-only' ? 'Official College Email' : 'College Email Address' %></label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required <%= pastDeadline ? 'disabled' : '' %> />
          <p class="hint">Approval updates and your submission ID confirmation reference this address.</p>
        </div>

        <div class="field">
          <label for="title">Entry Title</label>
          <input type="text" id="title" name="title" value="<%= values.title || '' %>" required <%= pastDeadline ? 'disabled' : '' %> />
        </div>

        <div class="field">
          <label for="description">Short Description (optional)</label>
          <textarea id="description" name="description" <%= pastDeadline ? 'disabled' : '' %>><%= values.description || '' %></textarea>
        </div>

        <div class="field">
          <label for="files">Upload Your Work</label>
          <input
            type="file"
            id="files"
            name="files"
            accept="<%= category.allowedExt.map(e => '.' + e).join(',') %>"
            <%= category.maxFiles > 1 ? 'multiple' : '' %>
            required
            <%= pastDeadline ? 'disabled' : '' %>
          />
          <p class="hint">Allowed: <%= category.allowedExt.join(', ').toUpperCase() %> — up to <%= category.maxFileSizeMB %>MB each, max <%= category.maxFiles %> file<%= category.maxFiles > 1 ? 's' : '' %>.</p>
        </div>

        <% if (category.audience === 'faculty-only') { %>
        <div class="field field-checkbox">
          <input type="checkbox" id="facultyConfirm" name="facultyConfirm" <%= pastDeadline ? 'disabled' : '' %> />
          <label for="facultyConfirm">I confirm I am a faculty member of the college.</label>
        </div>
        <% } %>

        <div class="field field-checkbox">
          <input type="checkbox" id="agree" name="agree" <%= pastDeadline ? 'disabled' : '' %> />
          <label for="agree">I confirm this work is my own, is appropriate for a college audience, and I agree to the <a href="/guidelines" target="_blank">competition guidelines</a>.</label>
        </div>

        <button type="submit" class="btn btn-primary btn-block" <%= pastDeadline ? 'disabled' : '' %>>Submit Entry</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
