<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<section class="admin-shell">
  <div class="container">
    <div class="admin-topbar">
      <div>
        <h1 style="margin-bottom:2px;">Admin Dashboard</h1>
        <p class="muted" style="margin:0;">Signed in as <%= admin.name %> (<%= admin.email %>)</p>
      </div>
      <div class="row-actions">
        <a href="/admin/entries/new" class="btn btn-primary btn-small">+ Add Entry</a>
        <a href="/admin/export.csv" class="btn btn-secondary btn-small">Export CSV</a>
        <form method="POST" action="/admin/logout" style="margin:0;">
          <button type="submit" class="btn btn-outline btn-small">Log Out</button>
        </form>
      </div>
    </div>

    <div id="statGrid" class="stat-grid"></div>

    <div class="tabs">
      <button type="button" class="tab-btn is-active" data-tab="submissions">Submissions</button>
      <button type="button" class="tab-btn" data-tab="categories">Category Stats</button>
      <button type="button" class="tab-btn" data-tab="devmail">Dev Mail Outbox</button>
    </div>

    <!-- SUBMISSIONS TAB -->
    <div id="tab-submissions" class="tab-panel">
      <div class="admin-filters">
        <select id="filterCategory">
          <option value="all">All categories</option>
          <% categories.forEach(c => { %><option value="<%= c.key %>"><%= c.label %></option><% }) %>
        </select>
        <input type="text" id="filterSearch" placeholder="Search name, college ID, submission ID, email…" style="min-width:240px;" />
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th><th>Category</th><th>Participant</th><th>Title</th>
              <th>Files</th><th>Votes</th><th>Submitted</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="submissionsBody">
            <tr><td colspan="8" class="center muted">Loading…</td></tr>
          </tbody>
        </table>
      </div>
      <div class="pagination" id="pagination"></div>
    </div>

    <!-- CATEGORY STATS TAB -->
    <div id="tab-categories" class="tab-panel" style="display:none;">
      <div class="form-card" style="max-width:640px;">
        <h3>Category-wise Statistics</h3>
        <div id="categoryStats"><p class="muted">Loading…</p></div>
      </div>
    </div>

    <!-- DEV MAIL TAB -->
    <div id="tab-devmail" class="tab-panel" style="display:none;">
      <div class="alert alert-info">
        These are OTP emails that were <strong>not</strong> actually sent because SMTP isn't configured yet
        (see .env.example). Use this to test the voting flow before real email is set up.
      </div>
      <div id="devMailList"></div>
    </div>
  </div>
</section>

<!-- EDIT ENTRY MODAL -->
<div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; padding:20px;">
  <div class="form-card" style="max-width:540px; width:100%; background:#fff; border-radius:12px; padding:24px; position:relative; box-shadow:0 10px 30px rgba(0,0,0,0.3);">
    <h3 style="margin-top:0; margin-bottom:16px;">Edit Submission Details</h3>
    <form id="editForm">
      <input type="hidden" id="editId" />
      <div class="field" style="margin-bottom:12px;">
        <label for="editName" style="font-size:13px;">Participant Name</label>
        <input type="text" id="editName" required style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:6px;" />
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="editCollegeId" style="font-size:13px;">College ID / Employee ID (optional)</label>
        <input type="text" id="editCollegeId" style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:6px;" />
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="editEmail" style="font-size:13px;">Email Address</label>
        <input type="email" id="editEmail" required style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:6px;" />
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="editTitle" style="font-size:13px;">Entry Title</label>
        <input type="text" id="editTitle" required style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:6px;" />
      </div>
      <div class="field" style="margin-bottom:16px;">
        <label for="editDescription" style="font-size:13px;">Description</label>
        <textarea id="editDescription" rows="3" style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:6px;"></textarea>
      </div>
      <p class="muted" style="font-size:12px; margin-bottom:16px;">Note: Category and uploaded files cannot be changed here. To change files or category, delete and re-add the entry.</p>
      <div id="editMsg" style="margin-bottom:12px; font-size:13px; color:var(--danger);"></div>
      <div style="display:flex; justify-content:flex-end; gap:10px;">
        <button type="button" id="closeEditModal" class="btn btn-outline btn-small">Cancel</button>
        <button type="submit" class="btn btn-primary btn-small">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
<script src="/js/admin.js"></script>
