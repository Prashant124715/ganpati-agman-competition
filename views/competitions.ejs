<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="section-title">Competition Categories</h1>
    <p class="section-subtitle"><%= site.competitionName %> has four categories — students and faculty are welcome across all of them, with Faculty Corner reserved specifically for faculty members.</p>

    <div class="category-grid">
      <% site.categories.forEach(cat => { %>
        <div class="category-card cat-<%= cat.key %>">
          <h3><%= cat.label %></h3>
          <p><%= cat.description %></p>
          <p class="muted"><strong>Accepted files:</strong> <%= cat.allowedExt.join(', ').toUpperCase() %> · up to <%= cat.maxFileSizeMB %>MB · max <%= cat.maxFiles %> file<%= cat.maxFiles > 1 ? 's' : '' %></p>
          <a href="/submit/<%= cat.key %>" class="btn btn-secondary btn-small">Submit an Entry</a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
