<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="form-card success-card">
      <h1>Your submission has been received successfully.</h1>
      <p class="muted">Keep this ID for your reference — quote it if you ever need to contact the <%= site.clubName %> about this entry.</p>
      <div class="success-code"><%= code %></div>
      <p class="muted">Your entry for <strong><%= category.label %></strong> is now <strong>pending review</strong>. Once approved by the organizers, it will appear on the <a href="/vote">voting page</a>.</p>
      <div class="hero__actions" style="margin-top:20px;">
        <a href="/submit" class="btn btn-secondary">Submit Another Entry</a>
        <a href="/" class="btn btn-outline">Back to Home</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
