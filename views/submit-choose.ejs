<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<% if (pastDeadline) { %>
  <div class="deadline-banner">The submission deadline for <%= site.competitionName %> has passed. Entries can no longer be accepted.</div>
<% } %>

<section class="section">
  <div class="container">
    <h1 class="section-title">Submit Your Entry</h1>
    <p class="section-subtitle">Choose the category that fits your work.</p>

    <div class="category-grid">
      <% site.categories.forEach(cat => { %>
        <div class="category-card cat-<%= cat.key %>">
          <h3><%= cat.label %></h3>
          <p><%= cat.description %></p>
          <a href="/submit/<%= cat.key %>" class="btn btn-primary btn-small">Choose <%= cat.shortLabel %></a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
